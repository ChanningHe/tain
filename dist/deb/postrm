#!/bin/sh
set -eu

case "$1" in
    purge)
        # Debian Policy §10.7.3: configuration files created by postinst are
        # removed on purge. Anything else an operator put in /etc/tain stays.
        rm -f /etc/tain/config.toml
        rmdir /etc/tain 2>/dev/null || true
        # The tain user and group are kept on purge, like /srv/mirrors: the
        # mirror data is owned by them, and deleting the account would let a
        # later account reuse the UID/GID and own (or modify) that data.
        # See https://wiki.debian.org/AccountHandlingInMaintainerScripts.
        # Drop the enable state that remove kept. disable removes the now
        # dangling links and works offline (chroot, image build) too.
        if command -v systemctl >/dev/null 2>&1; then
            systemctl disable tain-sync.timer tain-daemon.service >/dev/null 2>&1 || true
        fi
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
esac

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi

exit 0
